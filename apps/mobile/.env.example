# Rent Management Nepal — mobile environment
#
# Copy to .env. NEVER put a secret in this file.
#
# Expo INLINES every EXPO_PUBLIC_* variable into the JavaScript bundle, which
# ships to end users and can be read from any installed copy of the app.
# API keys, FCM server credentials and database URLs must never appear here
# (CLAUDE.md §20, §32).

# Base URL of the API.
#
# "localhost" refers to the phone itself, not your development machine, so a
# physical device testing over Expo Go needs your machine's LAN address:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
#
# Android emulator uses http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
