{
  "name": "@rms/api",
  "version": "0.1.0",
  "private": true,
  "description": "Rent Management Nepal — Express + TypeScript API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:unseed": "tsx src/db/seed.ts --clean",
    "db:review-account": "tsx src/db/review-account.ts",
    "postinstall": "prisma generate",
    "test:security": "node scripts/security-e2e.mjs",
    "verify:fcm": "tsx scripts/verify-fcm.ts",
    "push:status": "tsx scripts/push-status.ts",
    "email:preview": "tsx scripts/send-test-email.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.29",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@rms/shared": "*",
    "better-auth": "1.6.29",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
