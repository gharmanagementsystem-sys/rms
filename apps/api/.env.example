# Rent Management Nepal — API environment
#
# Copy to .env and fill in. NEVER commit .env (see root .gitignore).
# Every variable here must be documented in docs/env.md.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Render injects its own PORT at runtime —
# do not set it manually in the Render dashboard.
PORT=4000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Comma-separated allowlist of browser origins, e.g.
#   CORS_ORIGINS=https://admin.example.com,https://staging.example.com
#
# Leave empty in development to reflect any origin.
# Leave empty in production to allow NO browser origin — native mobile clients
# are not subject to CORS, so this is the safe default.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------

# Use Neon's POOLED connection string (the host contains "-pooler").
# The API will refuse to start if this is missing or malformed.
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/rms?sslmode=require

# Maximum connections held by this instance. Keep small — Neon's pooler is what
# scales connections, and a large per-instance pool exhausts the project budget.
DATABASE_POOL_MAX=10

# Neon requires TLS in every environment. Set to false only for a local
# PostgreSQL instance that has no TLS configured.
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------

# Signs session tokens. REQUIRED — there is deliberately no default.
# Generate one with:  openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public base URL of this API. Google OAuth callback URLs are built from it,
# so it must match what is registered in the Google Cloud console.
# On Render this is your service URL, e.g. https://rms-api.onrender.com
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth credentials (Google Cloud console → Credentials → OAuth client).
# Optional in development; REQUIRED in production — the API refuses to boot
# without them when NODE_ENV=production.
#
# Authorized redirect URI to register:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deep-link scheme of the mobile app. Must match "scheme" in apps/mobile/app.json,
# or the OAuth redirect back into the app is rejected as an untrusted origin.
MOBILE_APP_SCHEME=rms

# Shown in email subjects and bodies.
APP_NAME=Rent Management Nepal

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
#
# Email verification and password reset depend on this. REQUIRED in production —
# without it a user who forgets their password has no recovery path, and an
# unverifiable address can squat an account.
#
# Any SMTP provider works: Resend, Brevo, Postmark, Zoho, Gmail app password.
# When unset in development, emails are written to the log instead of sent, so
# the verification link is still reachable.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address. Must be on a domain the provider has verified.
SMTP_FROM="Rent Management Nepal <no-reply@example.com>"
# true for implicit TLS on port 465; false for STARTTLS on 587.
SMTP_SECURE=false

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Email — Resend (preferred)
# ---------------------------------------------------------------------------
#
# Used in preference to SMTP when both are set, because Resend returns a
# message id and a readable error. A blocked port 587 or an unverified domain
# is diagnosable; over SMTP the same failures look like a timeout.
#
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# From address. The domain must be verified with the provider.
#
# Resend accepts onboarding@resend.dev with no verified domain, but delivers
# ONLY to the Resend account owner. To email real users, verify a domain at
# https://resend.com/domains and use an address on it.
#
#   EMAIL_FROM=Gharbeti <no-reply@gharbeti.com>
EMAIL_FROM=

# Verify the whole setup and preview every template:
#   npm run email:preview -w @rms/api
#   npm run email:preview -w @rms/api -- --send you@example.com

# Push notifications (FCM)
#
# Firebase service account JSON, base64-encoded — the raw key is multi-line
# JSON and does not survive an environment variable intact:
#   base64 -w0 service-account.json
#
# These are SERVER credentials. They must NEVER reach the mobile app.
# REQUIRED in production.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Scheduled jobs
#
# Render's Cron Job service triggers jobs over HTTP, so those routes are
# publicly reachable and carry their own bearer token — a scheduler has no
# session cookie. Generate with: openssl rand -base64 32
#
#   POST <BETTER_AUTH_URL>/api/internal/jobs/generate-periods
#   POST <BETTER_AUTH_URL>/api/internal/jobs/rent-reminders
#   POST <BETTER_AUTH_URL>/api/internal/jobs/dispatch-push
#   POST <BETTER_AUTH_URL>/api/internal/jobs/prune-devices
# ---------------------------------------------------------------------------
JOB_RUNNER_TOKEN=replace-me-with-at-least-24-random-characters

# Runs the scheduler inside the web process. Leave false on Render — a separate
# Cron Job service keeps working across deploys and restarts.
ENABLE_IN_PROCESS_SCHEDULER=false
